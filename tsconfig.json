{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@clem/chat-engine": ["./packages/chat-engine/src/index.ts"],
      "@clem/chat-engine/*": ["./packages/chat-engine/src/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.vitest.ts",
    "src/**/*.test.ts",
    "node_modules"
  ]
}
