{
  "name": "clemmy",
  "version": "3.18.3",
  "description": "Local-first AI operator with persistent memory, governed tools, workflows, voice, and meetings",
  "license": "MIT",
  "homepage": "https://github.com/Natebreynolds/clemmy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Natebreynolds/clemmy.git"
  },
  "bugs": {
    "url": "https://github.com/Natebreynolds/clemmy/issues"
  },
  "keywords": [
    "agent",
    "ai",
    "assistant",
    "automation",
    "electron",
    "local-first",
    "memory",
    "openai",
    "mcp",
    "workflows"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "clementine": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/execution/reviewed-local-workflow-v3-process.fixture.js",
    "!dist/journeys/*.fixture.js",
    "!dist/journeys/*.fixture-support.js",
    "!dist/runtime/harness/current-capability-manifest.fixture.js",
    "apps/mobile-web/dist",
    "apps/console-web/dist",
    "builtin-skills",
    "vendor/uv",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "clean:dist": "node scripts/clean-dist.mjs",
    "check:public-hygiene": "node scripts/check-public-hygiene.mjs",
    "prebuild": "npm run clean:dist",
    "build": "node --import tsx scripts/build-candidate.mjs",
    "build:mobile-web": "npm --prefix apps/mobile-web run build",
    "build:console-web": "npm --prefix apps/console-web run build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests-isolated.mjs",
    "test:prospective": "node scripts/run-tests-isolated.mjs src/runtime/prospective-intentions.test.ts src/runtime/prospective-adapters.test.ts src/runtime/timers.test.ts src/runtime/harness/context-packet.test.ts src/runtime/harness/claude-agent-brain.test.ts src/agents/plan-proposals.test.ts src/execution/background-tasks.test.ts src/execution/workflow-scheduler.test.ts src/execution/workflow-trigger-engine.test.ts src/dashboard/console-goals.test.ts",
    "test:public-hygiene": "node scripts/run-tests-isolated.mjs scripts/check-public-hygiene.test.mjs",
    "test:release-assets": "node scripts/run-tests-isolated.mjs apps/desktop/scripts/vendor-recall-native.test.mjs scripts/implementation-artifact-freshness.test.mjs scripts/merge-mac-update-feeds.test.mjs scripts/mobile-web-build-freshness.test.mjs scripts/refresh-notarized-dmg-metadata.test.mjs scripts/release-workflow.test.mjs scripts/run-tests-isolated.test.mjs scripts/vendor-whispercpp-desktop.test.mjs scripts/verify-desktop-release-assets.test.mjs",
    "test:release-closure": "node scripts/run-tests-isolated.mjs packages/chat-engine/src/engine.test.ts packages/chat-engine/src/progress-phase.test.ts scripts/build-source-stability.red.test.mjs scripts/dev-launch-readiness.red.test.mjs scripts/harness-smoke-cleanup.test.ts apps/desktop/scripts/mac-native-deps.test.mjs scripts/dev-down-active-acceptance.test.mjs scripts/rehearse-v314-upgrade.test.mts",
    "bench:gates": "tsx scripts/harness-gate-benchmark.ts",
    "eval:passk": "tsx scripts/eval-passk.ts",
    "eval:memory": "tsx scripts/eval-memory-reliability.ts",
    "audit:memory": "tsx scripts/audit-memory-readiness.ts",
    "repair:memory-fk": "tsx scripts/repair-memory-foreign-keys.ts",
    "rehearse:memory": "tsx scripts/rehearse-memory-migration.ts",
    "rehearse:upgrade:v314": "tsx scripts/rehearse-v314-upgrade.mts",
    "eval:spans": "tsx scripts/eval-spans.ts",
    "eval:promote": "tsx scripts/eval-promote.ts",
    "measure:efficiency": "tsx scripts/measure-efficiency.ts",
    "measure:sessions": "tsx scripts/compare-sessions.ts",
    "measure:turns": "tsx scripts/compare-turns.ts",
    "probe:judge": "tsx scripts/probe-boundary-judge.ts",
    "probe:judge:live": "tsx scripts/probe-judge-live.ts",
    "stress:memory": "tsx scripts/memory-roundtrip-stress.ts",
    "smoke:fusion-readiness": "tsx scripts/smoke-fusion-readiness.ts",
    "smoke:objective-workflow": "tsx scripts/smoke-objective-workflow.mts",
    "smoke:workflow-reliability": "tsx scripts/smoke-workflow-reliability.mts",
    "smoke:workflows": "npm run smoke:objective-workflow && npm run smoke:workflow-reliability",
    "test:smoke": "node scripts/smoke-fresh-install.mjs && node scripts/smoke-fresh-install-e2e.mjs && node scripts/smoke-packed-candidate.mjs",
    "test:smoke:gate": "node scripts/smoke-fresh-install.mjs",
    "test:packed-candidate": "node scripts/smoke-packed-candidate.mjs",
    "test:packaged-upgrade": "node scripts/run-tests-isolated.mjs scripts/rehearse-v314-packaged-daemon.test.mts",
    "smoke:codex-native-compaction": "node scripts/smoke-codex-native-compaction.mjs",
    "smoke:report-back": "tsx scripts/smoke-unified-report-back.ts",
    "vendor:uv": "node scripts/vendor-uv.mjs",
    "vendor:whisper": "node scripts/vendor-whispercpp.mjs",
    "vendor:whisper:desktop": "node scripts/vendor-whispercpp-desktop.mjs",
    "smoke:markitdown": "node scripts/smoke-markitdown.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepack": "npm run build && npm run build:mobile-web && npm run build:console-web && npm run vendor:uv",
    "pack:local": "npm pack",
    "chat": "tsx src/index.ts chat",
    "daemon": "tsx src/index.ts daemon",
    "daemon:start": "tsx src/index.ts daemon start",
    "daemon:stop": "tsx src/index.ts daemon stop",
    "daemon:status": "tsx src/index.ts daemon status",
    "daemon:logs": "tsx src/index.ts daemon logs",
    "service": "tsx src/index.ts service",
    "webhook": "tsx src/index.ts webhook",
    "discord": "tsx src/index.ts discord",
    "setup": "tsx src/index.ts setup",
    "doctor": "tsx src/setup/doctor.ts",
    "init-home": "tsx src/index.ts init-home",
    "auth": "tsx src/index.ts auth",
    "mcp": "tsx src/tools/mcp-server.ts",
    "plugin": "tsx src/index.ts plugin",
    "smoke:all": "bash scripts/smoke-all.sh",
    "eval:jobs": "tsx scripts/eval-jobs.ts",
    "measure:judge-calibration": "tsx scripts/measure-judge-calibration.ts",
    "proof": "tsx scripts/proof/run-proof.ts",
    "proof:claude": "tsx scripts/proof/run-proof.ts --brain claude",
    "proof:codex": "tsx scripts/proof/run-proof.ts --brain codex",
    "proof:glm": "tsx scripts/proof/run-proof.ts --brain glm",
    "proof:critical": "tsx scripts/proof/run-proof.ts --require-brains claude,codex,glm --scenario long-horizon-manifest,background-steer-in-flight,converse-first,restart-resume,blocked-auth-truth,capability-reconnect-resume,discovery-reuse-horizon",
    "proof:critical:dev": "tsx scripts/proof/run-proof.ts --allow-dirty-dev --require-brains claude,codex,glm --scenario long-horizon-manifest,background-steer-in-flight,converse-first,restart-resume,blocked-auth-truth,capability-reconnect-resume,discovery-reuse-horizon",
    "proof:critical:codex": "tsx scripts/proof/run-proof.ts --brain codex --require-brains codex --scenario long-horizon-manifest,background-steer-in-flight,converse-first,restart-resume,blocked-auth-truth,capability-reconnect-resume,discovery-reuse-horizon",
    "proof:critical:codex:dev": "tsx scripts/proof/run-proof.ts --allow-dirty-dev --brain codex --require-brains codex --scenario long-horizon-manifest,background-steer-in-flight,converse-first,restart-resume,blocked-auth-truth,capability-reconnect-resume,discovery-reuse-horizon",
    "proof:clem4-horizon": "tsx scripts/proof/run-proof.ts --require-brains claude,codex,glm --scenario discovery-reuse-horizon",
    "proof:clem4-horizon:codex": "tsx scripts/proof/run-proof.ts --brain codex --require-brains codex --scenario discovery-reuse-horizon",
    "proof:clem4-horizon:dev": "tsx scripts/proof/run-proof.ts --allow-dirty-dev --require-brains claude,codex,glm --scenario discovery-reuse-horizon",
    "proof:clem4-horizon:codex:dev": "tsx scripts/proof/run-proof.ts --allow-dirty-dev --brain codex --require-brains codex --scenario discovery-reuse-horizon",
    "proof:clem4-conversation": "tsx scripts/proof/run-proof.ts --require-brains claude,codex,glm --scenario conversation-switch-resume-horizon",
    "proof:clem4-conversation:codex": "tsx scripts/proof/run-proof.ts --brain codex --require-brains codex --scenario conversation-switch-resume-horizon",
    "proof:clem4-conversation:dev": "tsx scripts/proof/run-proof.ts --allow-dirty-dev --require-brains claude,codex,glm --scenario conversation-switch-resume-horizon",
    "proof:clem4-conversation:codex:dev": "tsx scripts/proof/run-proof.ts --allow-dirty-dev --brain codex --require-brains codex --scenario conversation-switch-resume-horizon",
    "proof:endurance:codex": "CLEMMY_PROOF_LONG_HORIZON_ITEMS=120 tsx scripts/proof/run-proof.ts --brain codex --scenario long-horizon-manifest",
    "proof:fusion:codex": "tsx scripts/proof/run-proof.ts --brain codex --fusion all --scenario fusion-bounded-verifier",
    "proof:selftest": "node scripts/run-tests-isolated.mjs scripts/proof/*.test.ts",
    "journeys": "node scripts/run-tests-isolated.mjs --test-concurrency=1 src/journeys/*.test.ts",
    "test:measurement": "node scripts/run-tests-isolated.mjs scripts/session-comparison.test.ts scripts/proof/first-run.test.ts scripts/proof/leg-totals.test.ts scripts/proof/version-comparison.test.ts scripts/proof/conversation-facts.test.ts scripts/proof/runtime-under-test.test.ts scripts/proof/benchmark-comparison.test.ts scripts/proof/report-output.test.ts scripts/proof/required-brains.test.ts scripts/proof/route-expectation.test.ts scripts/proof/source-guard.test.ts scripts/proof/score.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.82",
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@composio/core": "^0.14.0",
    "@inquirer/prompts": "^8.4.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/agents": "^0.13.5",
    "@openai/agents-core": "^0.13.5",
    "@openai/agents-extensions": "^0.13.5",
    "@openai/agents-openai": "^0.13.5",
    "@openai/agents-realtime": "^0.13.5",
    "@slack/bolt": "^4.7.3",
    "3d-force-graph": "^1.80.0",
    "ai": "^6.0.199",
    "better-sqlite3": "^12.11.1",
    "cytoscape": "^3.33.3",
    "discord.js": "^14.27.0",
    "express": "^4.22.2",
    "gray-matter": "^4.0.3",
    "parse5": "8.0.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "undici": "^6.27.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "fast-uri": "^3.1.2",
    "hono": "^4.12.27",
    "ip-address": "^10.2.0",
    "qs": "^6.15.2",
    "sharp": "0.35.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.12.0",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "js-yaml": "^5.2.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
